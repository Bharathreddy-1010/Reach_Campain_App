{
  "expo": {
    "name": "Reach",
    "slug": "reach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reach",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reach.amplification",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Reachie requires microphone access to listen to your voice commands and help create campaigns.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.reach.amplification",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D3557"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9ae61cb0-450d-491e-bda2-5e1f7c243993"
      }
    },
    "owner": "bharath_1010"
  }
}
